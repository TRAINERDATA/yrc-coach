# 값은 = 뒤에 바로, 따옴표 없이. 같은 줄에 # 주석을 달지 마세요.

# ---- 필수 ----
# console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
# Railway/Fly 볼륨을 쓰면 /data/yrc.db
DB_PATH=./data/yrc.db
# 폰에서 접근할 서버 주소
PUBLIC_BASE_URL=https://your-app.up.railway.app
# 매일 브리핑 시각 (Asia/Seoul)
BRIEF_HOUR=7
BRIEF_MINUTE=0
TZ=Asia/Seoul

# ---- 알림 채널 (쓰는 것만) ----
# @BotFather 에서 발급
TELEGRAM_BOT_TOKEN=
# developers.kakao.com 앱 REST API 키 (나에게 보내기)
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:8000/kakao/callback
# ntfy 앱 쓸 때
NTFY_SERVER=https://ntfy.sh

# ---- 코치 설정 ----
CLAUDE_MODEL=claude-opus-5
COACH_EFFORT=medium
